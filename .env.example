# ─────────────────────────────────────────────────────────────────────────────
# Environment variables
# Copy this file to .env and fill in the values.
# Product-specific names: see README.md → Start a new project.
# ─────────────────────────────────────────────────────────────────────────────

# ── Product ───────────────────────────────────────────────────────────────────
PROJECT_NAME=API

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (local Docker) ───────────────────────────────────────────────────
POSTGRES_DB=dev
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Database (production — Railway injects this; do not set POSTGRES_* ) ──────
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Refresh cookie ────────────────────────────────────────────────────────────
# REFRESH_COOKIE_NAME=dev_refresh
# REFRESH_COOKIE_SAMESITE=Lax

# ── Email (dev: Mailpit at http://localhost:8025) ─────────────────────────────
DEFAULT_FROM_EMAIL=noreply@localhost

# ── Email (prod: fill these in for production SMTP) ───────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── DigitalOcean Spaces (production only) ─────────────────────────────────────
# DO_SPACES_KEY=your-spaces-access-key
# DO_SPACES_SECRET=your-spaces-secret-key
# DO_SPACES_BUCKET=your-static-bucket
# DO_SPACES_REGION=nyc3
# DO_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# DO_SPACES_STATIC_PREFIX=static/
# DO_SPACES_MEDIA_PREFIX=media/
# DO_SPACES_CUSTOM_DOMAIN=cdn.yourdomain.com

# ── Frontend URL (used in welcome-email get-started link) ─────────────────────
FRONTEND_URL=http://localhost:5173

# Optional dedicated HMAC key for JWTs. If unset, DJANGO_SECRET_KEY is used.
# JWT_SIGNING_KEY=

# ── Sentry (optional) ────────────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
