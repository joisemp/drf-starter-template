# ─────────────────────────────────────────────────────────────────────────────
# Frontend developer env
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file in TWO places in the React project:
#
#   .env       — Compose reads API_IMAGE (and optional POSTGRES_*) from here.
#                Must sit next to docker-compose.frontend-dev.yml.
#
#   .env.api   — Passed into the API container (Django). Do not rely on this
#                file to set the image name.
#
# See README.md → Start a new project.
# ─────────────────────────────────────────────────────────────────────────────

# Compose interpolates this from .env (not from .env.api):
API_IMAGE=ghcr.io/<owner>/<repo>:dev

PROJECT_NAME=API

DJANGO_SECRET_KEY=frontend-dev-secret-not-for-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=dev
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# REFRESH_COOKIE_NAME=dev_refresh
# REFRESH_COOKIE_SAMESITE=Lax

DEFAULT_FROM_EMAIL=noreply@localhost

FRONTEND_URL=http://localhost:5173

# JWT_SIGNING_KEY=
